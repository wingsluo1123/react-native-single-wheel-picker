{
  "name": "@hxa-rn/react-native-single-wheel-picker",
  "displayName": "@hxa-rn/react-native-single-wheel-picker",
  "version": "3.0.0",
  "description": "react-native-single-wheel-picker for HarmonyOS",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "react-native": "./dist/module/index.js",
  "types": "./dist/typescript/index.d.ts",
  "license": "MIT",
  "private": false,
  "keywords": [
    "react-native",
    "harmony",
    "harmonyos"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/",
    "src/",
    "harmony/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "bob build",
    "codegen-lib": "react-native codegen-lib-harmony --no-safety-check --npm-package-name wheel_picker_android --cpp-output-path ./harmony/wheel_picker_android/src/main/cpp/generated --ets-output-path ./harmony/wheel_picker_android/src/main/ets/generated --arkts-components-spec-paths ./src/specs/v1/WheelPickerNativeComponent.ts"
  },
  "peerDependencies": {
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "typescript": "5.0.4",
    "@react-native/typescript-config": "0.79.5",
    "react": "18.2.0",
    "@types/react": "18.2.79",
    "react-native": "0.72.5",
    "jest": "^29.6.3",
    "react-native-builder-bob": "^0.18.0",
    "@react-native-oh/react-native-harmony-cli": "^0.77.50",
    "metro": "^0.81.0"
  },
  "engines": {
    "node": ">=18"
  },
  "harmony": {
    "alias": "react-native-wheel-picker-android",
    "autolinking": {
      "cmakeLibraryTargetName": "wheel_picker_android",
      "ohPackageName": "@hxa-rn/react-native-single-wheel-picker",
      "etsPackageClassName": "GeneratedPackage",
      "cppPackageClassName": "WheelPickerAndroidPackage"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "dependencies": {
    "@react-native-ohos/picker": "~2.6.4",
    "moment": "^2.24.0"
  }
}
